# ============================================================================
#  Xiks Collection — environment variables
#
#  Local (node server.js):  none of these are required. Without them the store
#  keeps its data in data/*.json — perfect for your own machine.
#
#  Vercel: SUPABASE_URL and SUPABASE_SERVICE_KEY are REQUIRED. Vercel has no
#  writable disk, so the JSON files cannot be used there.
#
#  Add them in  Vercel → Project → Settings → Environment Variables,
#  then redeploy (env changes only apply to new deployments).
# ============================================================================

# ---- storage (required on Vercel) ------------------------------------------
# Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# the secret "service_role" key from the same page.
# SERVER-SIDE ONLY. Never put this in a web page or send it to a browser —
# it bypasses Row Level Security and can read/write everything.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- strongly recommended on Vercel ----------------------------------------
# Signs the admin login sessions. Any long random string (40+ characters).
# Set it once and never change it, or every signed-in device is logged out.
# If you skip it the server derives one from the Supabase key.
#SESSION_SECRET=change-me-to-a-long-random-string

# bucket for photos uploaded in the admin panel (created by supabase/schema.sql)
#SUPABASE_BUCKET=product-photos

# ---- optional --------------------------------------------------------------
# create the admin account on first boot instead of the generated one
#ADMIN_USER=xiks
#ADMIN_PASSWORD=pick-your-own-password

# port for local hosting only; Vercel ignores it
#PORT=8080

# OPEN_ADMIN=1 opens the panel with no password at all — setup only, never live
#OPEN_ADMIN=0
