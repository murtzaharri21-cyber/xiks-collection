# ============================================================================
#  Xiks Collection — environment variables
#
#  You do NOT need this file to run the store (it works on local JSON files).
#  Set these two only when you want the data in Supabase — see README →
#  "Using Supabase". On a host, add them as environment variables there.
#
#  Copy to ".env" if your host reads .env files, or export them in the shell:
#     export $(grep -v '^#' .env | xargs) && node server.js
# ============================================================================

# Project URL — Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# the secret "service_role" key from the same page.
# SERVER-SIDE ONLY. Never put this in a web page or send it to a browser —
# it bypasses Row Level Security and can read/write everything.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------- optional --
# port for the store server (default 8080)
#PORT=8080

# create/reset the admin account on first start instead of the default one
#ADMIN_USER=xiks
#ADMIN_PASSWORD=choose-a-strong-password
